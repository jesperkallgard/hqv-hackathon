{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    // The node:test files import with an explicit .ts extension, which is what
    // Node needs for native type stripping. Nothing emits, so this is safe.
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": [
    "node_modules",
    // A hackathon's own components, written by an agent at speed for a room
    // that is watching. `next.config.ts` already refuses to let one of them
    // fail a build, for the reason set out there; this is the same line drawn
    // in the same place, so `npm run typecheck` checks the site's own code and
    // says so truthfully. `app/blocks/Post.tsx` is the site's and is checked.
    "app/blocks/*/**"
  ]
}
