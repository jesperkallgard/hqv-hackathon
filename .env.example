# Shared password for the whole deployment. Unset means the gate is off, which
# is what you want locally. Set it in Vercel for preview and production.
SITE_PASSWORD=
# Optional. Changing it invalidates every issued gate cookie.
SITE_PASSWORD_SALT=

# --- Step 2 and later ---
# AI Gateway key for all model calls. Token reporting from here is what feeds
# the token budget.
AI_GATEWAY_API_KEY=
# Repo the agent commits content to.
GITHUB_REPO=jesperkallgard/hqv-hackathon
